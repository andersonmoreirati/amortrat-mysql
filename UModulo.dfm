  object OrdensNaoFilalizadas: TRxQuery
    AutoCalcFields = False
    DatabaseName = 'Amortrat'
    ParamCheck = False
    SQL.Strings = (
      'select c.fantasia CLIENTE,'
      'c.codigo CODIGO_CLIENTE, '
      'o.codigo CODIGO, '
      'o.data DATA_ABERTURA, '
      'o.quantidade QUANTIDADE, '
      'o.peso PESO, '
      'p.codigo CODIGO_PECA,'
      'p.descricao PECA,'
      'p.preco PRECO_KG,'
      'extract(MONTH from o.data)  MES_OS_ABERTURA,'
      'extract(year from o.data)  ANO_OS_ABERTURA,'
      'o.peso * p.preco valor_estimado'
      'from  os o, clientes c, pecas p'
      'where '
      ' extract(MONTH from o.data) >= '#39'01'#39#9#9
      ' and  extract(YEAR from o.data) >= '#39'2013'#39
      ' and o.cliente = c.codigo'
      ' and o.peca = p.codigo'
      ' and c.codigo = p.cod_cli'
      ' and o.finalizada = false')
    UpdateMode = upWhereKeyOnly
    Macros = <>
    Left = 544
    Top = 104
