  object VendasGerais: TRxQuery
    AutoCalcFields = False
    DatabaseName = 'Amortrat'
    ParamCheck = False
    SQL.Strings = (
      'select c.fantasia CLIENTE,'
      'c.codigo CODIGO_CLIENTE, '
      'f.codigo CODIGO_OS, '
      'o.data DATA_ABERTURA, '
      'f.data_fim DATA_FIM, '
      'f.valor VALOR, '
      'o.quantidade QUANTIDADE, '
      'o.peso PESO, '
      'p.codigo CODIGO_PECA,'
      'p.descricao PECA,'
      'p.preco PRECO_KG,'
      'f.valor / o.peso PRECO_COBRADO,'
      'extract(MONTH from f.data_fim)  MES_OS_FIM,'
      'extract(year from f.data_fim)  ANO_OS_FIM'
      'from  os_finalizados f, os o, clientes c, pecas p'
      'where '
      ' extract(MONTH from f.data_fim) >= '#39'01'#39#9#9
      ' and  extract(YEAR from f.data_fim) >= '#39'2013'#39
      ' and f.codigo = o.codigo'
      ' and o.cliente = c.codigo'
      ' and o.peca = p.codigo'
      ' and c.codigo = p.cod_cli')
    UpdateMode = upWhereKeyOnly
    Macros = <>
    Left = 544
    Top = 48
    object VendasGeraisCLIENTE: TStringField
      FieldName = 'CLIENTE'
    end
    object VendasGeraisCODIGO_CLIENTE: TStringField
      FieldName = 'CODIGO_CLIENTE'
      Size = 4
    end
    object VendasGeraisCODIGO_OS: TStringField
      DisplayWidth = 9
      FieldName = 'CODIGO_OS'
      Size = 9
    end
    object VendasGeraisDATA_ABERTURA: TDateField
      FieldName = 'DATA_ABERTURA'
    end
    object VendasGeraisDATA_FIM: TDateField
      FieldName = 'DATA_FIM'
    end
    object VendasGeraisVALOR: TCurrencyField
      FieldName = 'VALOR'
    end
