      FieldName = 'CODIGO_PECA'
      Size = 3
    end
    object VendasGeraisPECA: TStringField
      FieldName = 'PECA'
      Size = 30
    end
    object VendasGeraisPRECO_KG: TCurrencyField
      FieldName = 'PRECO_KG'
