  object QDeleta: TQuery
    DatabaseName = 'Amortrat'
    SQL.Strings = (
      
        'delete from apontamento WHERE ap.CODIGO_EQUIP=:equip AND ap.DATA' +
        '_INI=:dataIni and ap.DATA_FIM=:dataFim')
    Left = 712
    Top = 80
    ParamData = <
