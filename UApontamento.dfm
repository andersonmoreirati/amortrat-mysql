  object QApontamento: TQuery
    AutoCalcFields = False
    DatabaseName = 'amortrat'
    ParamCheck = False
    SQL.Strings = (
      
        'select eq.descricao FORNO, t.descricao TIPO, f.NOME FUNCIONARIO,' +
        ' ap.* '
      
        'from equipamentos eq, apontamento ap, tipo_apontamento t, funcio' +
        'nario f'
      'WHERE eq.CODIGO = ap.codigo_equip'
      'AND ap.tipo = t.codigo'
      'AND ap.FUNCIONARIO = f.CODIGO'
      
        'AND ap.CODIGO_EQUIP=:equip AND ap.DATA_INI>=:dataIni and ap.DATA' +
        '_FIM<=:dataFim')
    Left = 744
    Top = 32
    ParamData = <
      item
        DataType = ftString
        Name = 'equip'
        ParamType = ptUnknown
      end
      item
        DataType = ftTimeStamp
        Name = 'dataIni'
        ParamType = ptUnknown
      end
      item
        DataType = ftTimeStamp
        Name = 'dataFim'
        ParamType = ptUnknown
      end>
